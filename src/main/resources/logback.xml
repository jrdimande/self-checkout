<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <!-- Diretório onde serão guardados os logs -->
    <property name="LOG_DIR" value="logs"/>

    <!-- Logs apresentados no terminal -->
    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss} %-5level [%thread] %logger{36} - %msg%n
            </pattern>
        </encoder>

    </appender>

    <!-- Logs guardados em ficheiro -->
    <appender name="FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_DIR}/selfcheckout.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_DIR}/selfcheckout-%d{yyyy-MM-dd}.log
            </fileNamePattern>

            <!-- Manter histórico dos últimos 30 dias -->
            <maxHistory>30</maxHistory>

        </rollingPolicy>

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss} %-5level [%thread] %logger{36} - %msg%n
            </pattern>
        </encoder>

    </appender>

    <!-- Nível mínimo de registo -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>